{
  "name": "homelab-jev",
  "version": "1.0.0",
  "description": "helper to pre process emails and todoist projects",
  "homepage": "https://github.com/arstrel/homelab-jev#readme",
  "bugs": {
    "url": "https://github.com/arstrel/homelab-jev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arstrel/homelab-jev.git"
  },
  "license": "ISC",
  "author": "Arstrel@gmail.com",
  "type": "module",
  "main": "dist/cli.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "@doist/todoist-sdk": "15.3.1",
    "@typesafe-ai/sdk": "0.6.0",
    "drizzle-orm": "0.45.3",
    "email-addresses": "5.0.0",
    "googleapis": "183.0.0",
    "html-to-text": "10.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "test": "node --import tsx scripts/test.ts",
    "test:coverage": "node --import tsx scripts/test.ts --coverage",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "node --import tsx scripts/check.ts",
    "fix": "biome check --write .",
    "test:integration": "node --import tsx scripts/integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env dist/cli.js db:migrate",
    "db:check": "node --env-file=.env dist/cli.js db:check",
    "connections": "node --env-file=.env dist/cli.js connections",
    "mail:preview": "node --env-file=.env dist/cli.js mail:preview",
    "mail:ingest": "node --env-file=.env dist/cli.js mail:ingest",
    "mail:sync": "node --env-file=.env dist/cli.js mail:sync",
    "worker": "node --import tsx scripts/mail-worker-cli.ts",
    "mail:status": "node --env-file=.env dist/cli.js mail:status",
    "mail:tasks": "node --env-file=.env dist/cli.js mail:tasks",
    "mail:classify": "node --env-file=.env dist/cli.js mail:classify",
    "brief:publish": "node --env-file=.env dist/cli.js brief:publish",
    "google:authorize": "node --import tsx scripts/google-authorize.ts",
    "verify:foundation": "node --import tsx scripts/verify-foundation.ts",
    "okf:check": "node --import tsx scripts/okf-check.ts",
    "okf:build": "node --import tsx scripts/okf-build.ts",
    "okf:visualize": "node --import tsx scripts/okf-visualize.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fission-ai/openspec": "1.14.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "cytoscape": "3.34.3",
    "dompurify": "3.4.16",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "marked": "18.1.0",
    "msw": "2.15.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "private": true,
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
