<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.arstrel.jev.brief-refresh</string>
<key>ProgramArguments</key><array>
<string>@NODE@</string><string>--env-file=@ENV_FILE@</string>
<string>@RELEASE@/dist/cli.js</string><string>brief:publish</string>
<string>--max-conversations</string><string>10</string>
<string>--days</string><string>7</string>
<string>--max-new</string><string>0</string>
</array>
<key>WorkingDirectory</key><string>@RELEASE@</string>
<key>StartInterval</key><integer>300</integer>
<key>RunAtLoad</key><true/>
<key>ProcessType</key><string>Background</string>
<key>ExitTimeOut</key><integer>30</integer>
<key>Umask</key><integer>63</integer>
<key>StandardOutPath</key><string>@LOGS@/brief-refresh.log</string>
<key>StandardErrorPath</key><string>@LOGS@/brief-refresh-error.log</string>
</dict></plist>
