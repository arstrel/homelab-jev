# Dummy examples only; .env is ignored. Keep GH_TOKEN separate from worker releases.
JEV_API_KEY=
# DB_URL takes precedence; omit it completely to use the individual DB_* fields.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jev
DB_USER=jev
DB_PASSWORD=
# Google authorization and Todoist are independent of ChatGPT connectors.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
TODOIST_API_TOKEN=
